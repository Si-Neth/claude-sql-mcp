{
  "name": "claude-sql-mcp",
  "version": "1.0.0",
  "description": "Read-only remote MCP server exposing Microsoft SQL Server (TRP_AMS) data to Claude for dashboard generation. Node.js/TypeScript only.",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "inspector": "npx -y @modelcontextprotocol/inspector node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "mssql": "^11.0.1",
    "express": "^4.21.2",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "node-cache": "^5.1.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "uuid": "^11.0.3",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
